rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Hardened Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isBoundedString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }
    function isBoundedList(val, maxLen) {
      return val is list && val.size() <= maxLen && (val.size() == 0 || val[0] is string);
    }

    // 3. Admins (read-only for self, never client-writable)
    match /admins/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    // 4. Private User Settings (/users/{userId})
    function isValidUserPrivate(data) {
      return isBoundedString(data.userId, 1, 128) &&
             isBoundedString(data.displayName, 1, 60) &&
             isBoundedString(data.countryIso, 2, 4) &&
             isBoundedString(data.fideFederation, 2, 5) &&
             data.privacyPublicProfile is bool &&
             data.privacyAllowMessages is bool &&
             data.privacyShowOnline is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;
      allow create: if isSignedIn() && isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'displayName', 'countryIso', 'fideFederation', 'privacyPublicProfile', 'privacyAllowMessages', 'privacyShowOnline', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'countryIso', 'fideFederation', 'privacyPublicProfile', 'privacyAllowMessages', 'privacyShowOnline', 'createdAt', 'updatedAt']) &&
                       isValidUserPrivate(incoming());
      allow update: if isSignedIn() && isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidUserPrivate(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'countryIso', 'fideFederation', 'privacyPublicProfile', 'privacyAllowMessages', 'privacyShowOnline', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    // 5. Public Profiles (/publicProfiles/{userId})
    function isValidPublicProfile(data) {
      return isBoundedString(data.userId, 1, 128) &&
             isBoundedString(data.username, 2, 40) &&
             (!('bio' in data) || isBoundedString(data.bio, 0, 240)) &&
             isBoundedString(data.countryIso, 2, 4) &&
             isBoundedString(data.fideFederation, 2, 5) &&
             data.bulletRating is int && data.bulletRating >= 100 && data.bulletRating <= 4000 &&
             data.blitzRating is int && data.blitzRating >= 100 && data.blitzRating <= 4000 &&
             data.rapidRating is int && data.rapidRating >= 100 && data.rapidRating <= 4000 &&
             data.classicalRating is int && data.classicalRating >= 100 && data.classicalRating <= 4000 &&
             data.puzzleRating is int && data.puzzleRating >= 100 && data.puzzleRating <= 4000 &&
             data.gamesPlayed is int && data.gamesPlayed >= 0 &&
             data.wins is int && data.wins >= 0 &&
             data.draws is int && data.draws >= 0 &&
             data.losses is int && data.losses >= 0 &&
             data.studyCount is int && data.studyCount >= 0 &&
             data.achievementsCount is int && data.achievementsCount >= 0 &&
             data.onlineStatus in ['online', 'playing', 'offline'] &&
             data.publicVisible is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /publicProfiles/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || existing().publicVisible == true || isAdmin());
      allow list: if isSignedIn() && (existing().publicVisible == true || existing().userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'username', 'countryIso', 'fideFederation', 'bulletRating', 'blitzRating', 'rapidRating', 'classicalRating', 'puzzleRating', 'gamesPlayed', 'wins', 'draws', 'losses', 'studyCount', 'achievementsCount', 'onlineStatus', 'publicVisible', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'username', 'bio', 'countryIso', 'fideFederation', 'bulletRating', 'blitzRating', 'rapidRating', 'classicalRating', 'puzzleRating', 'gamesPlayed', 'wins', 'draws', 'losses', 'studyCount', 'achievementsCount', 'onlineStatus', 'publicVisible', 'createdAt', 'updatedAt']) &&
                       isValidPublicProfile(incoming());
      allow update: if isSignedIn() && isValidId(userId) &&
                       (request.auth.uid == userId || isAdmin()) &&
                       isValidPublicProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       (isAdmin() || incoming().diff(existing()).affectedKeys().hasOnly(['username', 'bio', 'countryIso', 'fideFederation', 'bulletRating', 'blitzRating', 'rapidRating', 'classicalRating', 'puzzleRating', 'gamesPlayed', 'wins', 'draws', 'losses', 'studyCount', 'achievementsCount', 'onlineStatus', 'publicVisible', 'updatedAt']));
      allow delete: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
    }

    // 6. Matchmaking Queue (/matchmaking/{ticketId})
    function isValidMatchTicket(data) {
      return isBoundedString(data.userId, 1, 128) &&
             isBoundedString(data.username, 2, 40) &&
             data.rating is int && data.rating >= 100 && data.rating <= 4000 &&
             isBoundedString(data.variant, 2, 30) &&
             isBoundedString(data.timeControl, 1, 30) &&
             data.ratedGame is bool &&
             data.minRating is int && data.minRating >= 100 &&
             data.maxRating is int && data.maxRating <= 4000 &&
             data.status in ['waiting', 'matched', 'cancelled'] &&
             (!('matchedGameId' in data) || isBoundedString(data.matchedGameId, 0, 128)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /matchmaking/{ticketId} {
      allow get: if isSignedIn() && isValidId(ticketId) && (existing().userId == request.auth.uid || existing().status == 'waiting');
      allow list: if isSignedIn() && (existing().status == 'waiting' || existing().userId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(ticketId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().status == 'waiting' &&
                       incoming().keys().hasAll(['userId', 'username', 'rating', 'variant', 'timeControl', 'ratedGame', 'minRating', 'maxRating', 'status', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'username', 'rating', 'variant', 'timeControl', 'ratedGame', 'minRating', 'maxRating', 'status', 'matchedGameId', 'createdAt', 'updatedAt']) &&
                       isValidMatchTicket(incoming());
      allow update: if isSignedIn() && isValidId(ticketId) &&
                       isValidMatchTicket(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       existing().status == 'waiting' &&
                       (
                         (existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
                         (incoming().status == 'matched' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'matchedGameId', 'updatedAt']))
                       );
      allow delete: if isSignedIn() && isValidId(ticketId) && existing().userId == request.auth.uid;
    }

    // 7. Online Games (/games/{gameId})
    function isValidOnlineGame(data) {
      return isBoundedString(data.whiteUid, 1, 128) &&
             isBoundedString(data.blackUid, 1, 128) &&
             isBoundedString(data.whiteName, 1, 50) &&
             isBoundedString(data.blackName, 1, 50) &&
             data.participantUids is list && data.participantUids.size() == 2 &&
             data.participantUids[0] is string && data.participantUids[1] is string &&
             isBoundedString(data.variant, 2, 30) &&
             isBoundedString(data.timeControl, 1, 30) &&
             data.initialTimeMs is int && data.initialTimeMs >= 0 &&
             data.incrementMs is int && data.incrementMs >= 0 &&
             data.delayMs is int && data.delayMs >= 0 &&
             data.ratedGame is bool &&
             data.status in ['waiting', 'active', 'finished', 'aborted'] &&
             isBoundedString(data.fen, 10, 220) &&
             isBoundedString(data.pgn, 0, 40000) &&
             (!('lastMoveUci' in data) || isBoundedString(data.lastMoveUci, 0, 12)) &&
             data.moveCount is int && data.moveCount >= 0 &&
             data.turn in ['w', 'b'] &&
             data.whiteTimeMs is int && data.whiteTimeMs >= 0 &&
             data.blackTimeMs is int && data.blackTimeMs >= 0 &&
             (!('drawOfferBy' in data) || isBoundedString(data.drawOfferBy, 0, 128)) &&
             (!('takebackOfferBy' in data) || isBoundedString(data.takebackOfferBy, 0, 128)) &&
             (!('result' in data) || isBoundedString(data.result, 0, 16)) &&
             (!('resultReason' in data) || isBoundedString(data.resultReason, 0, 64)) &&
             (!('winnerUid' in data) || isBoundedString(data.winnerUid, 0, 128)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /games/{gameId} {
      allow get: if isSignedIn() && isValidId(gameId) && (request.auth.uid in existing().participantUids || existing().status == 'active' || existing().status == 'finished');
      allow list: if isSignedIn() && (request.auth.uid in existing().participantUids || existing().status == 'active');
      allow create: if isSignedIn() && isValidId(gameId) &&
                       request.auth.uid in incoming().participantUids &&
                       incoming().keys().hasAll(['whiteUid', 'blackUid', 'whiteName', 'blackName', 'participantUids', 'variant', 'timeControl', 'initialTimeMs', 'incrementMs', 'delayMs', 'ratedGame', 'status', 'fen', 'pgn', 'moveCount', 'turn', 'whiteTimeMs', 'blackTimeMs', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['whiteUid', 'blackUid', 'whiteName', 'blackName', 'participantUids', 'variant', 'timeControl', 'initialTimeMs', 'incrementMs', 'delayMs', 'ratedGame', 'status', 'fen', 'pgn', 'lastMoveUci', 'moveCount', 'turn', 'whiteTimeMs', 'blackTimeMs', 'drawOfferBy', 'takebackOfferBy', 'result', 'resultReason', 'winnerUid', 'createdAt', 'updatedAt']) &&
                       isValidOnlineGame(incoming());
      allow update: if isSignedIn() && isValidId(gameId) &&
                       isValidOnlineGame(incoming()) &&
                       incoming().whiteUid == existing().whiteUid &&
                       incoming().blackUid == existing().blackUid &&
                       incoming().participantUids == existing().participantUids &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         isAdmin() ||
                         (
                           request.auth.uid in existing().participantUids &&
                           existing().status in ['waiting', 'active'] &&
                           (
                             // Action: Play Move / Update Board
                             incoming().diff(existing()).affectedKeys().hasOnly(['fen', 'pgn', 'lastMoveUci', 'moveCount', 'turn', 'whiteTimeMs', 'blackTimeMs', 'drawOfferBy', 'takebackOfferBy', 'status', 'result', 'resultReason', 'winnerUid', 'updatedAt']) ||
                             // Action: Draw / Takeback Offer
                             incoming().diff(existing()).affectedKeys().hasOnly(['drawOfferBy', 'takebackOfferBy', 'updatedAt']) ||
                             // Action: Resign / Abort / Complete
                             incoming().diff(existing()).affectedKeys().hasOnly(['status', 'result', 'resultReason', 'winnerUid', 'updatedAt'])
                           )
                         )
                       );
      allow delete: if isAdmin();

      // 7b. In-Game Chat (/games/{gameId}/chat/{messageId})
      match /chat/{messageId} {
        allow get, list: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/games/$(gameId)).data.participantUids || isAdmin());
        allow create: if isSignedIn() && isValidId(messageId) &&
                         incoming().senderUid == request.auth.uid &&
                         request.auth.uid in incoming().participantUids &&
                         isBoundedString(incoming().senderName, 1, 50) &&
                         isBoundedString(incoming().text, 1, 300) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().keys().hasAll(['senderUid', 'senderName', 'text', 'participantUids', 'createdAt']) &&
                         incoming().keys().hasOnly(['senderUid', 'senderName', 'text', 'participantUids', 'createdAt']) &&
                         request.auth.uid in get(/databases/$(database)/documents/games/$(gameId)).data.participantUids;
        allow update, delete: if isAdmin();
      }
    }

    // 8. Friendships (/friends/{friendshipId})
    function isValidFriendship(data) {
      return isBoundedString(data.requesterUid, 1, 128) &&
             isBoundedString(data.recipientUid, 1, 128) &&
             data.memberUids is list && data.memberUids.size() == 2 &&
             data.requesterUid in data.memberUids && data.recipientUid in data.memberUids &&
             isBoundedString(data.requesterName, 1, 50) &&
             isBoundedString(data.recipientName, 1, 50) &&
             data.status in ['pending', 'accepted', 'blocked'] &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /friends/{friendshipId} {
      allow get: if isSignedIn() && isValidId(friendshipId) && request.auth.uid in existing().memberUids;
      allow list: if isSignedIn() && request.auth.uid in existing().memberUids;
      allow create: if isSignedIn() && isValidId(friendshipId) &&
                       incoming().requesterUid == request.auth.uid &&
                       incoming().status == 'pending' &&
                       incoming().keys().hasAll(['requesterUid', 'recipientUid', 'memberUids', 'requesterName', 'recipientName', 'status', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['requesterUid', 'recipientUid', 'memberUids', 'requesterName', 'recipientName', 'status', 'createdAt', 'updatedAt']) &&
                       isValidFriendship(incoming());
      allow update: if isSignedIn() && isValidId(friendshipId) &&
                       request.auth.uid in existing().memberUids &&
                       isValidFriendship(incoming()) &&
                       incoming().requesterUid == existing().requesterUid &&
                       incoming().recipientUid == existing().recipientUid &&
                       incoming().memberUids == existing().memberUids &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(friendshipId) && request.auth.uid in existing().memberUids;
    }

    // 9. Direct Messages (/messages/{threadId} and /items/{msgId})
    match /messages/{threadId} {
      allow get, list: if isSignedIn() && request.auth.uid in existing().memberUids;
      allow create: if isSignedIn() && isValidId(threadId) &&
                       request.auth.uid in incoming().memberUids &&
                       incoming().memberUids is list && incoming().memberUids.size() == 2 &&
                       isBoundedString(incoming().lastMessage, 0, 300) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       incoming().keys().hasAll(['memberUids', 'lastMessage', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['memberUids', 'lastMessage', 'createdAt', 'updatedAt']);
      allow update: if isSignedIn() && isValidId(threadId) &&
                       request.auth.uid in existing().memberUids &&
                       incoming().memberUids == existing().memberUids &&
                       incoming().createdAt == existing().createdAt &&
                       isBoundedString(incoming().lastMessage, 0, 300) &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['lastMessage', 'updatedAt']);
      allow delete: if false;

      match /items/{msgId} {
        allow get, list: if isSignedIn() && request.auth.uid in existing().memberUids;
        allow create: if isSignedIn() && isValidId(msgId) &&
                         incoming().senderUid == request.auth.uid &&
                         request.auth.uid in incoming().memberUids &&
                         isBoundedString(incoming().senderName, 1, 50) &&
                         isBoundedString(incoming().text, 1, 1000) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().keys().hasAll(['senderUid', 'senderName', 'text', 'memberUids', 'createdAt']) &&
                         incoming().keys().hasOnly(['senderUid', 'senderName', 'text', 'memberUids', 'createdAt']);
        allow update, delete: if false;
      }
    }

    // 10. Cloud Studies (/studies/{studyId})
    function isValidCloudStudy(data) {
      return isBoundedString(data.ownerUid, 1, 128) &&
             isBoundedString(data.ownerName, 1, 50) &&
             isBoundedString(data.title, 1, 120) &&
             isBoundedString(data.description, 0, 1000) &&
             isBoundedString(data.pgn, 0, 100000) &&
             isBoundedList(data.tags, 10) &&
             data.publicVisible is bool &&
             isBoundedList(data.collaboratorUids, 20) &&
             data.chapterCount is int && data.chapterCount >= 1 && data.chapterCount <= 64 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /studies/{studyId} {
      allow get: if isSignedIn() && isValidId(studyId) && (existing().ownerUid == request.auth.uid || request.auth.uid in existing().collaboratorUids || existing().publicVisible == true);
      allow list: if isSignedIn() && (existing().ownerUid == request.auth.uid || request.auth.uid in existing().collaboratorUids || existing().publicVisible == true);
      allow create: if isSignedIn() && isValidId(studyId) &&
                       incoming().ownerUid == request.auth.uid &&
                       incoming().keys().hasAll(['ownerUid', 'ownerName', 'title', 'description', 'pgn', 'tags', 'publicVisible', 'collaboratorUids', 'chapterCount', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['ownerUid', 'ownerName', 'title', 'description', 'pgn', 'tags', 'publicVisible', 'collaboratorUids', 'chapterCount', 'createdAt', 'updatedAt']) &&
                       isValidCloudStudy(incoming());
      allow update: if isSignedIn() && isValidId(studyId) &&
                       isValidCloudStudy(incoming()) &&
                       incoming().ownerUid == existing().ownerUid &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         (existing().ownerUid == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'pgn', 'tags', 'publicVisible', 'collaboratorUids', 'chapterCount', 'updatedAt'])) ||
                         (request.auth.uid in existing().collaboratorUids && incoming().diff(existing()).affectedKeys().hasOnly(['pgn', 'chapterCount', 'updatedAt']))
                       );
      allow delete: if isSignedIn() && isValidId(studyId) && (existing().ownerUid == request.auth.uid || isAdmin());
    }

    // 11. Clubs (/clubs/{clubId} and /messages/{msgId})
    function isValidClub(data) {
      return isBoundedString(data.ownerUid, 1, 128) &&
             isBoundedString(data.name, 2, 80) &&
             isBoundedString(data.description, 0, 500) &&
             isBoundedString(data.countryIso, 2, 4) &&
             isBoundedList(data.memberUids, 200) &&
             data.memberCount is int && data.memberCount >= 1 &&
             data.publicVisible is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /clubs/{clubId} {
      allow get: if isSignedIn() && isValidId(clubId) && (existing().publicVisible == true || request.auth.uid in existing().memberUids || isAdmin());
      allow list: if isSignedIn() && (existing().publicVisible == true || request.auth.uid in existing().memberUids || isAdmin());
      allow create: if isSignedIn() && isValidId(clubId) &&
                       incoming().ownerUid == request.auth.uid &&
                       request.auth.uid in incoming().memberUids &&
                       incoming().keys().hasAll(['ownerUid', 'name', 'description', 'countryIso', 'memberUids', 'memberCount', 'publicVisible', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['ownerUid', 'name', 'description', 'countryIso', 'memberUids', 'memberCount', 'publicVisible', 'createdAt', 'updatedAt']) &&
                       isValidClub(incoming());
      allow update: if isSignedIn() && isValidId(clubId) &&
                       isValidClub(incoming()) &&
                       incoming().ownerUid == existing().ownerUid &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         isAdmin() ||
                         (existing().ownerUid == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'countryIso', 'memberUids', 'memberCount', 'publicVisible', 'updatedAt'])) ||
                         (existing().publicVisible == true && incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'memberCount', 'updatedAt']))
                       );
      allow delete: if isSignedIn() && isValidId(clubId) && (existing().ownerUid == request.auth.uid || isAdmin());

      match /messages/{msgId} {
        allow get, list: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/clubs/$(clubId)).data.memberUids;
        allow create: if isSignedIn() && isValidId(msgId) &&
                         incoming().senderUid == request.auth.uid &&
                         isBoundedString(incoming().senderName, 1, 50) &&
                         isBoundedString(incoming().text, 1, 500) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().keys().hasAll(['senderUid', 'senderName', 'text', 'createdAt']) &&
                         incoming().keys().hasOnly(['senderUid', 'senderName', 'text', 'createdAt']) &&
                         request.auth.uid in get(/databases/$(database)/documents/clubs/$(clubId)).data.memberUids;
        allow update, delete: if isAdmin();
      }
    }

    // 12. Teams (/teams/{teamId})
    function isValidTeam(data) {
      return isBoundedString(data.captainUid, 1, 128) &&
             isBoundedString(data.name, 2, 80) &&
             isBoundedString(data.description, 0, 500) &&
             isBoundedList(data.memberUids, 200) &&
             data.ratingAvg is int && data.ratingAvg >= 100 && data.ratingAvg <= 4000 &&
             data.publicVisible is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /teams/{teamId} {
      allow get: if isSignedIn() && isValidId(teamId) && (existing().publicVisible == true || request.auth.uid in existing().memberUids || isAdmin());
      allow list: if isSignedIn() && (existing().publicVisible == true || request.auth.uid in existing().memberUids || isAdmin());
      allow create: if isSignedIn() && isValidId(teamId) &&
                       incoming().captainUid == request.auth.uid &&
                       request.auth.uid in incoming().memberUids &&
                       incoming().keys().hasAll(['captainUid', 'name', 'description', 'memberUids', 'ratingAvg', 'publicVisible', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['captainUid', 'name', 'description', 'memberUids', 'ratingAvg', 'publicVisible', 'createdAt', 'updatedAt']) &&
                       isValidTeam(incoming());
      allow update: if isSignedIn() && isValidId(teamId) &&
                       isValidTeam(incoming()) &&
                       incoming().captainUid == existing().captainUid &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         isAdmin() ||
                         (existing().captainUid == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'memberUids', 'ratingAvg', 'publicVisible', 'updatedAt'])) ||
                         (existing().publicVisible == true && incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updatedAt']))
                       );
      allow delete: if isSignedIn() && isValidId(teamId) && (existing().captainUid == request.auth.uid || isAdmin());
    }

    // 13. Tournaments (/tournaments/{tournamentId} and /entries/{entryId})
    function isValidTournament(data) {
      return isBoundedString(data.creatorUid, 1, 128) &&
             isBoundedString(data.name, 2, 80) &&
             data.format in ['arena', 'swiss', 'simul'] &&
             isBoundedString(data.variant, 2, 30) &&
             isBoundedString(data.timeControl, 1, 30) &&
             data.ratedGame is bool &&
             data.status in ['upcoming', 'active', 'finished'] &&
             data.round is int && data.round >= 0 &&
             data.maxRounds is int && data.maxRounds >= 1 && data.maxRounds <= 20 &&
             isBoundedList(data.participantUids, 200) &&
             data.publicVisible is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /tournaments/{tournamentId} {
      allow get: if isSignedIn() && isValidId(tournamentId) && (existing().publicVisible == true || request.auth.uid in existing().participantUids || isAdmin());
      allow list: if isSignedIn() && (existing().publicVisible == true || request.auth.uid in existing().participantUids || isAdmin());
      allow create: if isSignedIn() && isValidId(tournamentId) &&
                       incoming().creatorUid == request.auth.uid &&
                       incoming().keys().hasAll(['creatorUid', 'name', 'format', 'variant', 'timeControl', 'ratedGame', 'status', 'round', 'maxRounds', 'participantUids', 'publicVisible', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['creatorUid', 'name', 'format', 'variant', 'timeControl', 'ratedGame', 'status', 'round', 'maxRounds', 'participantUids', 'publicVisible', 'createdAt', 'updatedAt']) &&
                       isValidTournament(incoming());
      allow update: if isSignedIn() && isValidId(tournamentId) &&
                       isValidTournament(incoming()) &&
                       incoming().creatorUid == existing().creatorUid &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         isAdmin() ||
                         (existing().creatorUid == request.auth.uid && existing().status != 'finished' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'round', 'participantUids', 'updatedAt'])) ||
                         (existing().publicVisible == true && existing().status != 'finished' && incoming().diff(existing()).affectedKeys().hasOnly(['participantUids', 'updatedAt']))
                       );
      allow delete: if isSignedIn() && isValidId(tournamentId) && (existing().creatorUid == request.auth.uid || isAdmin());

      match /entries/{entryId} {
        allow get, list: if isSignedIn() && (get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.publicVisible == true || isAdmin());
        allow create: if isSignedIn() && isValidId(entryId) &&
                         incoming().userId == request.auth.uid &&
                         isBoundedString(incoming().username, 2, 40) &&
                         incoming().rating is int && incoming().rating >= 100 && incoming().rating <= 4000 &&
                         incoming().points is int && incoming().points >= 0 &&
                         incoming().streak is int && incoming().streak >= 0 &&
                         incoming().gamesPlayed is int && incoming().gamesPlayed >= 0 &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         incoming().keys().hasAll(['userId', 'username', 'rating', 'points', 'streak', 'gamesPlayed', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'username', 'rating', 'points', 'streak', 'gamesPlayed', 'createdAt', 'updatedAt']);
        allow update: if isSignedIn() && isValidId(entryId) &&
                         (existing().userId == request.auth.uid || isAdmin()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().points is int && incoming().points >= 0 &&
                         incoming().streak is int && incoming().streak >= 0 &&
                         incoming().gamesPlayed is int && incoming().gamesPlayed >= 0 &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['points', 'streak', 'gamesPlayed', 'updatedAt']);
        allow delete: if isSignedIn() && isValidId(entryId) && (existing().userId == request.auth.uid || isAdmin());
      }
    }

    // 14. Moderation & Abuse Reports (/reports/{reportId})
    function isValidReport(data) {
      return isBoundedString(data.reporterUid, 1, 128) &&
             isBoundedString(data.targetUid, 1, 128) &&
             isBoundedString(data.category, 2, 50) &&
             isBoundedString(data.details, 4, 1000) &&
             data.status in ['open', 'reviewed', 'resolved'] &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /reports/{reportId} {
      allow get: if isSignedIn() && isValidId(reportId) && (existing().reporterUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().reporterUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(reportId) &&
                       incoming().reporterUid == request.auth.uid &&
                       incoming().status == 'open' &&
                       incoming().keys().hasAll(['reporterUid', 'targetUid', 'category', 'details', 'status', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['reporterUid', 'targetUid', 'category', 'details', 'status', 'createdAt', 'updatedAt']) &&
                       isValidReport(incoming());
      allow update: if isAdmin() && isValidId(reportId) &&
                       isValidReport(incoming()) &&
                       incoming().reporterUid == existing().reporterUid &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isAdmin();
    }
  }
}
